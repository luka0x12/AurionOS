// Run: vanta /Development/hello.vanta
// Variables, functions and loops. println ends each line.
fn triangular(n) {
    let total = 0
    for let i = 1; i <= n; i++ { total += i }
    return total
}
println("Hello, AurionOS!")
for let n = 1; n <= 8; n++ {
    println("Triangle ", n, " = ", triangular(n))
}
assert(triangular(8) == 36)
